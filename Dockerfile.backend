FROM python:3.11-slim

WORKDIR /app

# Persisted directories. Mount a volume at /data in production so the
# SQLite DB, trained scorer and failure-story JSON survive container
# restarts. In a single-shot container run the defaults are fine.
ENV RENEW_DATA_DIR=/data \
    RENEW_MODELS_DIR=/data/models \
    PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app

# Generate synthetic data + train the scorer on first boot so the API is
# immediately usable; then start the API.
CMD ["sh", "-c", "python -m app.generate_data --n 500 && python -m app.train_scorer && uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
